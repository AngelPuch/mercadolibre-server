          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "errores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "msg": {
                "type": "string"
              },
