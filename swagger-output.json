  "securityDefinitions": {
    "BearerJWT": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT válido con el formato Bearer <token>. Roles Usuario o Administrador; propietario obtenido exclusivamente del claim sub."
    }
  },
  "definitions": {
    "CarritoItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productoId",
        "titulo",
        "archivoid",
        "cantidad",
        "precioUnitario",
        "subtotal"
      ],
      "properties": {
        "productoId": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 2147483647,
          "example": 1
        },
        "titulo": {
          "type": "string"
        },
        "archivoid": {
          "type": "integer",
          "x-nullable": true
        },
        "cantidad": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999,
          "example": 2
        },
        "precioUnitario": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$",
          "example": "19.90",
          "description": "Importe decimal exacto con dos decimales, calculado por el servidor a partir del precio actual de la BD."
        },
        "subtotal": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$",
          "example": "39.80",
          "description": "Importe decimal exacto con dos decimales, calculado por el servidor a partir del precio actual de la BD."
        }
      }
    },
    "Carrito": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "subtotal"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CarritoItem"
          }
        },
        "subtotal": {
          "type": "string",
          "pattern": "^-?\\d+\\.\\d{2}$",
          "example": "39.80",
          "description": "Importe decimal exacto con dos decimales, calculado por el servidor a partir del precio actual de la BD."
        }
      },
      "example": {
        "items": [
          {
            "productoId": 1,
            "titulo": "Producto de ejemplo",
            "archivoid": null,
            "cantidad": 2,
            "precioUnitario": "19.90",
            "subtotal": "39.80"
          }
        ],
        "subtotal": "39.80"
      }
    },
    "CarritoAgregar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productoId",
        "cantidad"
      ],
      "properties": {
        "productoId": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 2147483647,
          "example": 1
        },
        "cantidad": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999,
          "example": 2
        }
      },
      "example": {
        "productoId": 1,
        "cantidad": 2
      }
    },
    "CarritoCantidad": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cantidad"
      ],
      "properties": {
        "cantidad": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999,
          "example": 2
        }
      },
      "example": {
        "cantidad": 4
      }
    },
    "CarritoResultado": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productoId",
        "cantidad"
      ],
      "properties": {
        "productoId": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 2147483647,
          "example": 1
        },
        "cantidad": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999,
          "example": 2
        }
      },
      "example": {
        "productoId": 1,
        "cantidad": 2
      }
    },
    "CarritoError": {
      "type": "object",
      "required": [
        "mensaje"
