      "example": {
        "pedidoId": 1,
        "fecha": "2026-11-18T18:00:00.000Z",
        "estado": "Confirmado",
        "total": "40.32",
        "items": [
          {
            "productoId": 1,
            "titulo": "Producto de ejemplo",
            "cantidad": 2,
            "precioUnitario": "20.01",
            "subtotal": "40.02"
          },
          {
            "productoId": 2,
            "titulo": "Otro producto",
            "cantidad": 3,
            "precioUnitario": "0.10",
            "subtotal": "0.30"
          }
        ]
      }
    },
    "PedidoError": {
      "type": "object",
      "required": [
        "mensaje"
      ],
      "properties": {
        "mensaje": {
          "type": "string"
        },
        "status": {
          "type": "integer"
        },
        "errores": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "msg": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          }
