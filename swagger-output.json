                "type": "string"
              }
            }
          }
        }
      }
    },
    "PedidoResumenItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productoId",
        "titulo",
        "cantidad",
        "precioUnitario",
        "subtotal"
      ],
      "properties": {
        "productoId": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        },
        "titulo": {
          "type": "string"
        },
