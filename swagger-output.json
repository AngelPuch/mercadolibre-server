    "/api/auth/": {
      "post": {
        "description": "Login con límite predeterminado de 30 solicitudes por IP cada 15 minutos. Configurable mediante LOGIN_RATE_LIMIT_MAX y LOGIN_RATE_LIMIT_WINDOW_MS. El límite solo aplica a este POST, usa req.ip y no comparte contadores con registro ni con otros procesos.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "example": "any"
                },
                "password": {
                  "example": "any"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Límite por IP o capacidad del limitador alcanzados. Los contadores son independientes por endpoint y por proceso.",
            "headers": {
              "Retry-After": {
                "type": "integer",
                "description": "Segundos antes de volver a intentar.",
                "minimum": 1
              }
            },
            "schema": {
              "type": "object",
              "properties": {
                "mensaje": {
                  "type": "string",
                  "example": "Demasiadas solicitudes. Inténtelo más tarde."
                }
              }
            }
          }
        }
      }
    },
