    "/api/carrito/": {
      "get": {
        "tags": [
          "Carrito"
        ],
        "produces": [
          "application/json"
        ],
        "security": [
          {
            "BearerJWT": []
          }
        ],
        "summary": "Consultar el carrito propio",
        "description": "No acepta query ni campos en el cuerpo. Sin carrito devuelve {\"items\":[],\"subtotal\":\"0.00\"}, sin crear una cabecera. Precios actuales de BD e importes calculados exactamente por el servidor; no incluye identificadores del propietario ni de carritos ajenos.",
        "responses": {
          "200": {
            "description": "Artículos y subtotal del carrito propio.",
            "schema": {
              "$ref": "#/definitions/Carrito"
            },
            "examples": {
              "application/json": {
                "items": [
                  {
                    "productoId": 1,
                    "titulo": "Producto de ejemplo",
                    "archivoid": null,
                    "cantidad": 2,
                    "precioUnitario": "19.90",
                    "subtotal": "39.80"
                  }
                ],
                "subtotal": "39.80"
              }
            }
          },
          "400": {
            "description": "Entrada inválida: cantidades fuera de 1..999, IDs inválidos, campos adicionales o parámetros de consulta. No se aceptan propietario, carrito ni importes del cliente.",
            "schema": {
              "$ref": "#/definitions/CarritoError"
            },
            "examples": {
              "application/json": {
                "mensaje": "La cantidad es obligatoria y debe ser un entero entre 1 y 999."
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido, o usuario propietario inexistente.",
            "schema": {
              "$ref": "#/definitions/CarritoError"
            }
          },
          "403": {
            "description": "Rol distinto de Usuario o Administrador.",
            "schema": {
              "$ref": "#/definitions/CarritoError"
            }
          },
          "500": {
            "description": "Error interno sin detalles SQL ni trazas. Si falla una escritura o su bitácora, la transacción se revierte.",
            "schema": {
              "$ref": "#/definitions/CarritoError"
            },
            "examples": {
